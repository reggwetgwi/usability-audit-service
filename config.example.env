# Скопировать в .env и заполнить. В коде промптов нет — только эти настройки.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Команда запуска Claude Code (на Windows может быть claude.cmd)
CLAUDE_BIN=claude
# Модель для аудитов, напр. claude-opus-4-8; пусто = модель по умолчанию из Claude Code
CLAUDE_MODEL=
# Промпт-команда. Сам сценарий аудита живёт в ~/.claude/skills/usability-audit/SKILL.md
AUDIT_COMMAND=/usability-audit {url}

# --- Приём заявок ---
# Секрет, который должна прислать веб-форма в заголовке X-Auth-Token
WEBHOOK_SECRET=придумайте-длинную-строку
# Максимум заявок в сутки (защита от выжигания токенов)
MAX_PER_DAY=5
# Таймаут одного аудита, секунд (90 минут)
AUDIT_TIMEOUT=5400

# --- Telegram (уведомления и кнопка подтверждения) ---
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Чат менеджера/группы, куда падают заявки и готовые отчёты.
# Узнать свой id: написать боту @userinfobot
TELEGRAM_CHAT_ID=123456789

# --- Хранилище ---
# Папка с базой очереди и рабочими папками аудитов
DATA_DIR=./data
