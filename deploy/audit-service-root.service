[Unit]
Description=Usability audit service (FastAPI + Claude Code)
After=network-online.target

[Service]
User=root
WorkingDirectory=/opt/audit-service
EnvironmentFile=/opt/audit-service/.env
ExecStart=/opt/audit-service/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
